{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "🟢 Next.js: Debug Server",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/.bin/next",
      "args": ["dev", "--turbopack"],
      "cwd": "${workspaceFolder}",
      "env": {
        "NODE_OPTIONS": "--inspect"
      },
      "envFile": "${workspaceFolder}/.env",
      "sourceMaps": true,
      "resolveSourceMapLocations": [
        "${workspaceFolder}/**",
        "!**/node_modules/**"
      ],
      "skipFiles": [
        "<node_internals>/**",
        "**/node_modules/**"
      ],
      "console": "integratedTerminal",
      "serverReadyAction": {
        "pattern": "ready started server on .+, url: (https?://.+)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    },
    {
      "name": "🔵 Next.js: Debug Client (Chrome)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}/src",
      "sourceMaps": true,
      "sourceMapPathOverrides": {
        "webpack://_N_E/./src/*": "${workspaceFolder}/src/*",
        "webpack://_N_E/*": "${workspaceFolder}/*"
      },
      "skipFiles": [
        "<node_internals>/**",
        "**/node_modules/**"
      ]
    },
    {
      "name": "🚀 Next.js: Full Stack Debug",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/.bin/next",
      "args": ["dev"],
      "cwd": "${workspaceFolder}",
      "env": {
        "NODE_OPTIONS": "--inspect"
      },
      "envFile": "${workspaceFolder}/.env",
      "sourceMaps": true,
      "resolveSourceMapLocations": [
        "${workspaceFolder}/**",
        "!**/node_modules/**"
      ],
      "skipFiles": [
        "<node_internals>/**",
        "**/node_modules/**"
      ],
      "console": "integratedTerminal",
      "serverReadyAction": {
        "pattern": "ready started server on .+, url: (https?://.+)",
        "uriFormat": "%s",
        "action": "startDebugging",
        "name": "🔵 Next.js: Debug Client (Chrome)"
      }
    },
    {
      "name": "🔌 Node.js: Attach to Running Dev Server",
      "type": "node",
      "request": "attach",
      "port": 9229,
      "sourceMaps": true,
      "resolveSourceMapLocations": [
        "${workspaceFolder}/**",
        "!**/node_modules/**"
      ],
      "skipFiles": [
        "<node_internals>/**",
        "**/node_modules/**"
      ],
      "restart": true
    },
    {
      "name": "🛠️ Debug edges (debug-edges.mjs)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/debug-edges.mjs",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "🧪 Debug flow test (test-flow.mjs)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/test-flow.mjs",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ],
  "compounds": [
    {
      "name": "🌐 Debug All (Server + Client)",
      "configurations": [
        "🟢 Next.js: Debug Server",
        "🔵 Next.js: Debug Client (Chrome)"
      ],
      "stopAll": true,
      "presentation": {
        "hidden": false,
        "group": "Next.js",
        "order": 1
      }
    }
  ]
}
