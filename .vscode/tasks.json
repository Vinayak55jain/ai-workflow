{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Trigger.dev",
      "type": "shell",
      "command": "npx trigger.dev@latest dev",
      "isBackground": true,
      "problemMatcher": {
        "pattern": [
          {
            "regexp": ".",
            "file": 1,
            "location": 2,
            "message": 3
          }
        ],
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*Waiting for tasks.*$",
          "endsPattern": "^.*Waiting for tasks.*$"
        }
      },
      "presentation": {
        "group": "trigger",
        "reveal": "always",
        "panel": "dedicated"
      }
    }
  ]
}
